# Copy to .env and fill in. Placeholders only; never commit real values.

# Anthropic API key for the agents (investigator, critic, remediator) and the eval judges
# (not used by `agent setup` or `agent scenario`). Holds a secret: chmod 600 .env
ANTHROPIC_API_KEY=sk-ant-...

# --- The agents (`agent investigate`) ---
# AGENT_USER_ID=alice                        # who is asking; unset = your OS user
# AGENT_MODEL=anthropic:claude-sonnet-5-5    # the investigator; LangChain model string
# AGENT_CRITIC_MODEL=                        # the evidence critic; unset = AGENT_MODEL
# AGENT_REMEDIATOR_MODEL=                    # the remediator (the one fix); unset = AGENT_MODEL
# AGENT_EFFORT=high                          # low | medium | high | xhigh | max (medium: few reasoning summaries)
# AGENT_MAX_TOOL_CALLS=15                    # per round; then calls are refused and it concludes
# AGENT_MAX_MODEL_CALLS=20                   # per round; then the run stops: inconclusive
# AGENT_RUN_MAX_TOOL_CALLS=30                # per run (investigator), across rounds; then calls are refused and it concludes
# AGENT_RUN_MAX_MODEL_CALLS=40               # per run (investigator); then inconclusive
# AGENT_RUN_MAX_SECONDS=300                  # agent working time per run (not the wait for your approval); then inconclusive
# AGENT_MAX_VERIFY_ROUNDS=2                  # critic verdicts per run; then unfounded = inconclusive
# AGENT_RECURSION_LIMIT=250                  # LangGraph steps per run: a backstop the limits beat
# AGENT_MAX_OUTPUT_TOKENS=8000               # per model call, thinking included
# AGENT_MODEL_MAX_RETRIES=2                  # retries on rate limits, 5xx, connection errors
# AGENT_TOOL_MAX_RETRIES=2                   # retries of a failed MCP call (not refused/not found)
# AGENT_TOOL_RETRY_DELAY_SECONDS=1           # first wait before a retry; doubles each time
# AGENT_TOOL_OUTPUT_MAX_CHARS=40000          # safety cap per tool result
# AGENT_TOOL_OUTPUT_STRIP_FIELDS=managedFields  # noise removed from tool output (comma-separated)
# AGENT_POD_LOG_TAIL_LINES=100               # max log lines pods_log returns (pod logs, not ours)
# AGENT_MCP_TIMEOUT_SECONDS=30               # per MCP tool call
# AGENT_EVIDENCE_EXCERPT_CHARS=1500          # output shown per cited step in the result JSON
# AGENT_PROGRESS_SUMMARY_CHARS=200           # reasoning summary length in progress lines
# AGENT_LOG_LEVEL=INFO                       # JSON logs: run start/finish + problems; DEBUG adds each tool call
# AGENT_LOG_FILE=                            # JSON logs to this file; unset = stderr, except in a terminal

# --- The fix (the selector scenario): you see the exact change and answer y/N ---
# AGENT_APPROVAL_TIMEOUT_SECONDS=600          # wait for your answer; then the fix is rejected
# AGENT_FIX_ENDPOINTS_WAIT_SECONDS=20         # max wait for the Service's ready endpoints after the fix (not the verify rounds)
# AGENT_FIX_ENDPOINTS_POLL_SECONDS=1          # how often the fix tool checks for them
# AGENT_REMEDIATOR_TIMEOUT_SECONDS=30         # per Kubernetes API call as the remediator

# --- Tracing (the MLflow tracking server: `docker compose up -d mlflow`) ---
MLFLOW_TRACKING_URI=http://localhost:5050    # the compose service `mlflow`; unset = no tracing
# MLFLOW_EXPERIMENT_NAME=k8s-agent
# MLFLOW_HTTP_REQUEST_TIMEOUT=3               # seconds per call to the tracking server
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=0           # MLflow's own default (7) retries for minutes: a stopped server would hold up exit
# MLFLOW_DISABLE_TELEMETRY=true               # MLflow's usage telemetry to its own servers (MLflow's default: on)
# AGENT_GIT_COMMIT=                          # the code's commit on traces and eval runs; unset = from .git (CI's images set it)

# --- Evals (`agent eval`; needs the tracking server, and the full mlflow package: in the image,
# and in `uv sync` for development) ---
# AGENT_EVAL_RUNS_PER_SCENARIO=1              # each scenario's question, asked this many times (3: to measure reliability)
# AGENT_EVAL_PASS_SHARE=0.667   # the diagnosis and both judges: pass in at least this share of the runs
# AGENT_JUDGE_MODEL=anthropic:/claude-opus-5-5  # both judges; an MLflow model URI (note the ":/")
# AGENT_JUDGE_ATTEMPTS=3                      # tries per verdict (failed call or unreadable answer); then the run fails that check
# AGENT_EVAL_MLFLOW_EXPERIMENT_NAME=k8s-agent-evals
# AGENT_EVAL_RESULTS_DIR=eval-results         # one JSON file per `agent eval`

# --- Cluster access for `agent setup`, `agent scenario` and `agent eval` (your own admin
# kubeconfig; `agent investigate` never uses it) ---
# Unset = $KUBECONFIG or ~/.kube/config, and its current context. The `admin` container mounts
# $KUBECONFIG (default ~/.kube/config) and sets this itself.
# AGENT_KUBECONFIG=/path/to/kubeconfig
# AGENT_KUBE_CONTEXT=orbstack         # e.g. OrbStack's; kind: kind-<cluster name>
# AGENT_KUBE_TIMEOUT_SECONDS=30       # per Kubernetes API call with it, so a stalled API server can't hang them

# --- Scenarios ---
# AGENT_SCENARIOS_DIR=scenarios
# AGENT_SCENARIO_READY_TIMEOUT_SECONDS=180   # max wait for the fault to be live after `up`
# AGENT_SCENARIO_DELETE_TIMEOUT_SECONDS=120  # max wait for the namespace to go after `down`
# AGENT_SCENARIO_POLL_SECONDS=2

# --- Agent identities (`agent setup`) ---
# AGENT_RBAC_FILE=deploy/rbac.yaml            # the identities; each scenario's namespace.yaml binds them
# AGENT_TOKEN_TTL_HOURS=12                    # token lifetime; re-run `agent setup` to refresh
# Where `agent setup` writes the two kubeconfigs (`uv run` only: compose uses these defaults)
# AGENT_READER_KUBECONFIG=.kube-agent/reader.kubeconfig          # mounted into k8s-mcp only
# AGENT_REMEDIATOR_KUBECONFIG=.kube-agent/remediator.kubeconfig  # used only by the remediator's tools
# AGENT_REMEDIATION_NAMESPACES=shop-checkout  # where the agent may propose and apply a fix

# --- Containers (the MCP server k8s-mcp, and agent and admin; host networking) ---
# AGENT_MCP_PORT=8080                         # port it listens on, on localhost
# AGENT_MCP_URL=http://localhost:8080/mcp     # unset = derived from AGENT_MCP_PORT
# AGENT_CONTAINER_USER=65532:65532            # native Linux Docker: your `id -u`:`id -g`, so the
#                                             # containers can read and write the 0600 kubeconfigs

# --- Acceptance tests only ---
# AGENT_ACCEPT_ASSERT_TIMEOUT_SECONDS=30     # retry window for state that flips (CrashLoopBackOff)
# AGENT_ACCEPT_REUSE_SCENARIOS=true         # tests after M1's keep running scenarios and leave them up
#                                             # (M6's rebuild the selector one); false = fresh ones, removed afterwards
# AGENT_ACCEPT_MLFLOW_EXPERIMENT_NAME=k8s-agent-tests  # where test runs trace (not MLFLOW_EXPERIMENT_NAME)
