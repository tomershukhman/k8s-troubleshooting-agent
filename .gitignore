# Secrets and local credentials. The two folders are kept (.gitkeep) so they exist, owned by
# you, before compose mounts them: on native Linux Docker would create them as root.
.env
.kube-agent/*
!.kube-agent/.gitkeep

# Assignment brief (employer's document; kept out of the repo)
*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# OS / editors
.DS_Store
.idea/
.vscode/

# `agent eval` results (the scores are also in MLflow)
eval-results/*
!eval-results/.gitkeep
.claude/worktrees/
